{
  "name": "@berkelium/cli",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "berkelium": "./dist/bin/berkelium.js",
    "bk": "./dist/bin/berkelium.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "start": "node ./dist/bin/berkelium.js",
    "dev": "tsx ./src/bin/berkelium.ts"
  },
  "dependencies": {
    "@berkelium/agent": "workspace:*",
    "@berkelium/auth": "workspace:*",
    "@berkelium/config": "workspace:*",
    "@berkelium/context": "workspace:*",
    "@berkelium/events": "workspace:*",
    "@berkelium/logging": "workspace:*",
    "@berkelium/permissions": "workspace:*",
    "@berkelium/plugins": "workspace:*",
    "@berkelium/providers": "workspace:*",
    "@berkelium/runtime": "workspace:*",
    "@berkelium/telemetry": "workspace:*",
    "@berkelium/themes": "workspace:*",
    "@berkelium/tools": "workspace:*"
  }
}
