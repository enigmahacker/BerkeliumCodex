{
  "name": "berkelium-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ultra-Customizable Terminal AI Coding Agent",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "typecheck": "tsc -b ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx --tsconfig tsconfig.base.json benchmarks/index.ts",
    "berkelium": "tsx --tsconfig tsconfig.base.json apps/cli/src/bin/berkelium.ts",
    "bk": "tsx --tsconfig tsconfig.base.json apps/cli/src/bin/berkelium.ts",
    "link:bin": "node -e 'const fs=require(\"fs\"),path=require(\"path\"),os=require(\"os\");const binDirs=[path.join(os.homedir(),\".local/bin\"),path.join(os.homedir(),\"Library/pnpm/bin\")];const targets={bk:path.resolve(\"./bin/bk\"),berkelium:path.resolve(\"./bin/berkelium\")};for(const dir of binDirs){if(fs.existsSync(dir)){for(const [name,target] of Object.entries(targets)){const link=path.join(dir,name);try{fs.unlinkSync(link);}catch{};try{fs.symlinkSync(target,link);console.log(\"Linked\",name,\"->\",link);}catch(e){console.warn(\"Could not link\",name,\"in\",dir,e.message);}}}}'",
    "lint": "tsc -b ./tsconfig.json"
  },
  "bin": {
    "bk": "./bin/bk",
    "berkelium": "./bin/berkelium"
  },
  "dependencies": {
    "@berkelium/agent": "workspace:*",
    "@berkelium/auth": "workspace:*",
    "@berkelium/cli": "workspace:*",
    "@berkelium/config": "workspace:*",
    "@berkelium/context": "workspace:*",
    "@berkelium/events": "workspace:*",
    "@berkelium/logging": "workspace:*",
    "@berkelium/permissions": "workspace:*",
    "@berkelium/plugins": "workspace:*",
    "@berkelium/providers": "workspace:*",
    "@berkelium/telemetry": "workspace:*",
    "@berkelium/themes": "workspace:*",
    "@berkelium/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
